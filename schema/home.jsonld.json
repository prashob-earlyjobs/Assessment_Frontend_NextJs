    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is EarlyJobs a Job Portal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. EarlyJobs is The Recruiter-First Hiring Network where recruiters, employers, and professionals connect through AI-powered hiring infrastructure."
          }
        },
        {
          "@type": "Question",
          "name": "Is EarlyJobs a Recruitment Agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Recruiters work independently while employers access recruiter-led hiring through the network."
          }
        },
        {
          "@type": "Question",
          "name": "How is EarlyJobs different from LinkedIn or Naukri?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditional platforms focus on listings or networking. EarlyJobs focuses on recruiter-guided hiring journeys and better hiring outcomes."
          }
        },
        {
          "@type": "Question",
          "name": "Is EarlyJobs only for Recruiters?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. EarlyJobs is designed for recruiters, employers, job seekers, recruitment agencies, and hiring partners. Recruiters simply sit at the center of the ecosystem."
          }
        },
        {
          "@type": "Question",
          "name": "Can freshers use EarlyJobs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Students, graduates, experienced professionals, and career changers can all build profiles and discover opportunities."
          }
        },
        {
          "@type": "Question",
          "name": "Why is AI part of EarlyJobs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AI removes repetitive tasks such as matching and screening. People continue making hiring decisions."
          }
        },
        {
          "@type": "Question",
          "name": "How do recruiters earn on EarlyJobs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Commercial terms are governed by the applicable recruiter programme or mandate agreement. Payment arrangements are subject to the applicable commercial terms."
          }
        },
        {
          "@type": "Question",
          "name": "How are EarlyJobs, Huntlo AI and GigKaro related?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Together, these businesses address different parts of the hiring landscape through recruitment execution and technology."
          }
        }
